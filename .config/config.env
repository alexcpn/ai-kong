# AI Kong settings, loaded by dk.py at start-up (python-dotenv). Shell variables win over this file.
# Load by hand with:  set -a; . .config/config.env; set +a
# Measured speeds and costs: docs/llm-speed/

# --- Endpoint ---
KONG_BASE_URL=https://openrouter.ai/api/v1   # any OpenAI-compatible endpoint
# KONG_PROVIDER=groq                         # fallback provider for any role without its own

# --- Default: cheapest (~$0.002-0.003 per minute of play) ---
# Strategist: studies the player, sets Kong's knobs (every ~20 s, and on a lost life or new level). ~6 s per plan.
KONG_DIRECTOR_MODEL=anthropic/claude-haiku-5.5
KONG_DIRECTOR_REASONING=medium               # none | low | medium | high
KONG_DIRECTOR_JSON=schema                    # schema (strict) | object (models without structured outputs)
# Voice: answers your taunts. ~1.9 s per reply.
KONG_VOICE_MODEL=anthropic/claude-haiku-5.5
KONG_VOICE_REASONING=none
# Tactician: off (it needs a sub-second model to be useful)
KONG_USE_TACTICIAN=0

# --- Fast setup (~1-1.5 cents per minute): comment out the block above, uncomment this one ---
# KONG_DIRECTOR_MODEL=openai/gpt-oss-120b
# KONG_DIRECTOR_REASONING=medium
# KONG_DIRECTOR_PROVIDER=cerebras            # ~2 s per plan
# KONG_VOICE_MODEL=openai/gpt-oss-120b
# KONG_VOICE_REASONING=low
# KONG_VOICE_PROVIDER=groq                   # ~0.4 s per reply
# KONG_USE_TACTICIAN=1                       # picks the throws at every Kong decision (~2 s)
# KONG_TACTICIAN_MODEL=openai/gpt-oss-20b
# KONG_TACTICIAN_REASONING=low
# KONG_TACTICIAN_PROVIDER=groq               # ~0.6 s; a late reply falls back to the knobs

# --- Timing ---
KONG_STRATEGY_EVERY=20

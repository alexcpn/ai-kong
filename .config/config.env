  # --- Endpoint ---
  KONG_BASE_URL=https://openrouter.ai/api/v1   # any OpenAI-compatible endpoint
  # KONG_PROVIDER=anthropic                    # optional: pin one OpenRouter provider

  # --- LLM Kong: strategist (plans every ~N game-seconds) ---
  KONG_STRATEGIST_MODEL=anthropic/claude-haiku-5.5
  KONG_STRATEGIST_REASONING=medium        # none | low | medium | high
  KONG_STRATEGIST_JSON=schema             # schema (strict) | object (models without structured outputs)

  # --- LLM Kong: tactician (every Kong decision, ~3 game-seconds) ---
  KONG_TACTICIAN_MODEL=anthropic/claude-haiku-5.5
  KONG_TACTICIAN_REASONING=low
  KONG_TACTICIAN_JSON=schema

  # --- Director Kong ---
  KONG_DIRECTOR_MODEL=anthropic/claude-haiku-5.5
  KONG_DIRECTOR_REASONING=medium
  KONG_DIRECTOR_JSON=schema

  # --- Timing ---
  KONG_STRATEGY_EVERY=20 